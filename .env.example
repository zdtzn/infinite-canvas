IMAGE_REPOSITORY=ghcr.io/zdtzn/infinite-canvas
# Pin a tested version or immutable digest for production. Do not track latest automatically.
IMAGE_TAG=latest
# Required by docker-compose.production.yml. Prefer an immutable sha256 digest.
IMAGE_REF=

# Direct-IP testing may use 0.0.0.0 temporarily. Keep 127.0.0.1 behind Caddy.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
DATA_VOLUME_NAME=infinite-canvas-data

# Fill these and switch both flags to 1 after the domain has resolved to the server.
DOMAIN=
PUBLIC_BASE_URL=
TRUST_PROXY=0
FORCE_SECURE_COOKIES=0

# Leave blank only for temporary local/direct-IP testing. Set a generated value before HTTPS deployment.
# Generate once (for example: openssl rand -base64 32), back it up, and keep it stable.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_PREVIOUS=

JOB_CONCURRENCY=2
HEAVY_REQUEST_CONCURRENCY=4
# Server-only target for free prompt optimization. When blank, the first text model
# from the administrator's channel order is used.
PROMPT_OPTIMIZE_CHANNEL_ID=
PROMPT_OPTIMIZE_MODEL=
PROMPT_OPTIMIZE_CONCURRENCY=2
PROMPT_OPTIMIZE_TIMEOUT_MS=60000
PROMPT_OPTIMIZE_RATE_LIMIT=8
UPSTREAM_TIMEOUT_MS=600000
# A provider may finish before this server can reach its result CDN. Keep this
# short so the browser can display a temporary HTTPS result while it is archived.
RESULT_IMAGE_DOWNLOAD_TIMEOUT_MS=8000
# Optional private Cloudflare Worker used to archive temporary UU result URLs.
# Configure both values together; keep the secret identical in Worker secrets.
RESULT_IMAGE_RELAY_URL=
RESULT_IMAGE_RELAY_SECRET=
RESULT_IMAGE_RELAY_TTL_SECONDS=120
RESULT_IMAGE_RELAY_DOWNLOAD_TIMEOUT_MS=30000
# Disable this when the server cannot reach workers.dev. Browser archiving remains enabled.
RESULT_IMAGE_RELAY_SERVER_DOWNLOAD=1
SHUTDOWN_GRACE_MS=20000

# Keep registration open only while onboarding invited members.
ALLOW_NEW_USERS=1
MAX_REGISTERED_USERS=20

# Per-user storage limits in bytes.
MAX_USER_ASSET_BYTES=2147483648
MAX_USER_JOB_FILE_BYTES=2147483648
MAX_IMAGE_REFERENCE_TOTAL_BYTES=67108864
MAX_PROJECTS_PER_USER=100
MAX_PROJECT_BYTES_PER_USER=134217728

# Reference-safe cleanup. Newly uploaded files have a 24-hour grace period.
ASSET_GC_ENABLED=1
ASSET_GC_GRACE_MS=86400000
ASSET_GC_INTERVAL_HOURS=24

# Local cache and completed-job retention.
MAX_PROMPT_CACHE_ENTRIES=2000
MAX_PROMPT_CACHE_BYTES=268435456
# Prompt source manifests/originals and transformed covers use separate queues.
PROMPT_PROXY_CONCURRENCY=3
PROMPT_THUMBNAIL_PROXY_CONCURRENCY=6
PROMPT_PROXY_TIMEOUT_MS=8000
JOB_RETENTION_MS=2592000000
MAX_TERMINAL_JOBS_PER_USER=200
MEDIA_TASK_RETENTION_MS=2592000000
MEDIA_TASK_ACTIVE_TTL_MS=7200000
MIN_FREE_DISK_BYTES=536870912

# Container guardrails used by Docker Compose.
APP_PIDS_LIMIT=256
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# SQLite snapshots stored inside the persistent data volume.
BACKUP_ENABLED=1
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_DIR=/data/backups

ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
